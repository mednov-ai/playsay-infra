[Unit]
Description=Honey School non-disruptive security maintenance observer
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/honey-school-host-maintenance --owner {{ maintenance_owner }} --publish
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/honeyschool/maintenance
TimeoutStartSec=240
