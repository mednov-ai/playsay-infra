[Unit]
Description=Reconcile Play&Say production and dev LiveKit DNAT
After=network-online.target ufw.service libvirtd.service
Wants=network-online.target
PartOf=libvirtd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/playsay-reconcile-livekit-nat

[Install]
WantedBy=multi-user.target
