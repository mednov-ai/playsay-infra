[Unit]
Description=Honey School fenced nightly maintenance owner
After=network-online.target honey-school-maintenance-agent.service
Requires=honey-school-maintenance-agent.service
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/honey-school-maintenance-execute
LoadCredential=keys:/etc/honey-school-maintenance/keys.json
UMask=0077
TimeoutStartSec=infinity
KillMode=process
SendSIGKILL=no
OOMPolicy=continue
