<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta
      name="description"
      content="Play&amp;Say English Studio offers live English lessons for children, teenagers and adults."
    >
    <title>Play&amp;Say English Studio</title>
    <style>
      :root {
        color-scheme: light;
        font-family: Manrope, Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: #111111;
        background: #fffaf7;
      }
      * { box-sizing: border-box; }
      body {
        min-height: 100vh;
        margin: 0;
        display: grid;
        place-items: center;
        overflow-x: hidden;
        background:
          radial-gradient(circle at 12% 16%, rgba(255, 217, 90, .28), transparent 28rem),
          radial-gradient(circle at 88% 82%, rgba(126, 224, 185, .22), transparent 26rem),
          #fffaf7;
      }
      main {
        position: relative;
        width: min(1080px, calc(100% - 32px));
        margin: 32px auto;
        padding: clamp(32px, 7vw, 84px);
        border: 1px solid #ece6df;
        border-radius: 24px;
        background: rgba(255, 255, 255, .94);
        box-shadow: 0 24px 70px rgba(83, 47, 24, .09);
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        margin-bottom: clamp(44px, 8vw, 90px);
        font-size: 20px;
        font-weight: 800;
        letter-spacing: -.04em;
      }
      .brand-mark {
        display: grid;
        width: 42px;
        height: 42px;
        place-items: center;
        border-radius: 13px;
        color: white;
        background: #ff5c00;
        box-shadow: 0 8px 20px rgba(255, 92, 0, .25);
      }
      .eyebrow {
        margin: 0 0 18px;
        color: #df4100;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: .12em;
        text-transform: uppercase;
      }
      h1 {
        max-width: 760px;
        margin: 0;
        font-size: clamp(42px, 8vw, 84px);
        line-height: .98;
        letter-spacing: -.065em;
      }
      .lead {
        max-width: 680px;
        margin: 28px 0 0;
        color: #62666f;
        font-size: clamp(17px, 2.3vw, 21px);
        line-height: 1.65;
      }
      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 36px;
      }
      a {
        display: inline-flex;
        min-height: 50px;
        align-items: center;
        justify-content: center;
        padding: 0 22px;
        border: 1px solid #ff5c00;
        border-radius: 10px;
        color: #df4100;
        font-weight: 750;
        text-decoration: none;
        transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
      }
      a:hover { transform: translateY(-2px); }
      a:focus-visible { outline: 3px solid rgba(255, 92, 0, .28); outline-offset: 3px; }
      .primary {
        color: white;
        background: #ff5c00;
        box-shadow: 0 10px 24px rgba(255, 92, 0, .22);
      }
      .primary:hover { background: #df4100; }
      footer {
        margin-top: clamp(60px, 10vw, 120px);
        padding-top: 22px;
        border-top: 1px solid #ece6df;
        color: #62666f;
        font-size: 14px;
      }
      @media (max-width: 560px) {
        main { width: min(100% - 20px, 1080px); margin: 10px auto; padding: 28px 22px; border-radius: 18px; }
        .brand { margin-bottom: 54px; }
        .actions { flex-direction: column; }
        a { width: 100%; }
      }
      @media (prefers-reduced-motion: reduce) {
        a { transition: none; }
      }
    </style>
  </head>
  <body>
    <main>
      <div class="brand" aria-label="Play and Say English Studio">
        <span class="brand-mark" aria-hidden="true">P&amp;S</span>
        <span>Play&amp;Say</span>
      </div>
      <p class="eyebrow">English studio and online learning</p>
      <h1>English that students want to speak.</h1>
      <p class="lead">
        Live individual and group lessons for children, teenagers and adults — with speaking practice,
        games and real-life communication at the heart of every class.
      </p>
      <div class="actions">
        <a class="primary" href="https://online.honey.school/">Open the learning platform</a>
        <a href="https://play-and-say.ru/">Visit the studio website</a>
      </div>
      <footer>Play&amp;Say English Studio · Learning through communication</footer>
    </main>
  </body>
</html>
