<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta
      name="description"
      content="Honey School offers live English lessons for children, teenagers and adults."
    >
    <meta name="theme-color" content="#FFF8E8">
    <meta property="og:site_name" content="Honey School">
    <meta property="og:title" content="Honey School">
    <meta property="og:description" content="Live English lessons with speaking, games and real communication.">
    <meta property="og:image" content="https://honey.school/brand/og/honey-school-card.png">
    <meta property="og:type" content="website">
    <link rel="icon" href="/brand/icons/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/brand/icons/favicon-32x32.png" sizes="32x32" type="image/png">
    <link rel="icon" href="/brand/icons/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="/brand/icons/apple-touch-icon.png" sizes="180x180">
    <link rel="mask-icon" href="/brand/icons/safari-pinned-tab.svg" color="#E99500">
    <link rel="manifest" href="/brand/icons/site.webmanifest">
    <title>Honey School</title>
    <style>
      @font-face {
        font-family: "Quicksand";
        src: url("/brand/fonts/quicksand-latin-400.woff2") format("woff2");
        font-style: normal;
        font-weight: 400;
        font-display: swap;
      }
      @font-face {
        font-family: "Quicksand";
        src: url("/brand/fonts/quicksand-latin-500.woff2") format("woff2");
        font-style: normal;
        font-weight: 500;
        font-display: swap;
      }
      @font-face {
        font-family: "Quicksand";
        src: url("/brand/fonts/quicksand-latin-600.woff2") format("woff2");
        font-style: normal;
        font-weight: 600;
        font-display: swap;
      }
      :root {
        color-scheme: light;
        font-family: Manrope, Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: #202433;
        background: #fff8e8;
      }
      * { box-sizing: border-box; }
      body {
        min-height: 100vh;
        margin: 0;
        display: grid;
        place-items: center;
        overflow-x: hidden;
        background:
          radial-gradient(circle at 12% 16%, rgba(255, 217, 90, .28), transparent 28rem),
          radial-gradient(circle at 88% 82%, rgba(126, 224, 185, .22), transparent 26rem),
          #fff8e8;
      }
      main {
        position: relative;
        width: min(1080px, calc(100% - 32px));
        margin: 32px auto;
        padding: clamp(32px, 7vw, 84px);
        border: 1px solid #e8dfcf;
        border-radius: 24px;
        background: rgba(255, 255, 255, .94);
        box-shadow: 0 24px 70px rgba(83, 47, 24, .09);
      }
      .brand {
        display: block;
        width: min(340px, 72vw);
        margin-bottom: clamp(44px, 8vw, 90px);
      }
      .brand img {
        display: block;
        width: 100%;
        height: auto;
      }
      .eyebrow {
        margin: 0 0 18px;
        color: #9a5700;
        font-size: 13px;
        font-family: "Quicksand", ui-rounded, system-ui, sans-serif;
        font-weight: 600;
        letter-spacing: .12em;
        text-transform: uppercase;
      }
      h1 {
        max-width: 760px;
        margin: 0;
        font-size: clamp(42px, 8vw, 84px);
        line-height: .98;
        letter-spacing: -.065em;
        font-family: "Quicksand", ui-rounded, system-ui, sans-serif;
        font-weight: 600;
      }
      .lead {
        max-width: 680px;
        margin: 28px 0 0;
        color: #667085;
        font-size: clamp(17px, 2.3vw, 21px);
        line-height: 1.65;
      }
      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 36px;
      }
      a {
        display: inline-flex;
        min-height: 50px;
        align-items: center;
        justify-content: center;
        padding: 0 22px;
        border: 1px solid #9a5700;
        border-radius: 10px;
        color: #9a5700;
        font-family: "Quicksand", ui-rounded, system-ui, sans-serif;
        font-weight: 600;
        text-decoration: none;
        transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
      }
      a:hover { transform: translateY(-2px); }
      a:focus-visible { outline: 3px solid rgba(154, 87, 0, .28); outline-offset: 3px; }
      .primary {
        color: #fff8e8;
        background: #202433;
        box-shadow: 0 10px 24px rgba(32, 36, 51, .18);
      }
      .primary:hover { background: #9a5700; }
      footer {
        margin-top: clamp(60px, 10vw, 120px);
        padding-top: 22px;
        border-top: 1px solid #e8dfcf;
        color: #667085;
        font-size: 14px;
      }
      @media (max-width: 560px) {
        main { width: min(100% - 20px, 1080px); margin: 10px auto; padding: 28px 22px; border-radius: 18px; }
        .brand { margin-bottom: 54px; }
        .actions { flex-direction: column; }
        a { width: 100%; }
      }
      @media (prefers-reduced-motion: reduce) {
        a { transition: none; }
      }
    </style>
  </head>
  <body>
    <main>
      <div class="brand" aria-label="Honey School">
        <img src="/brand/logo/honey-school-logo.svg" width="1080" height="215" alt="">
      </div>
      <p class="eyebrow">English studio and online learning</p>
      <h1>English that students want to speak.</h1>
      <p class="lead">
        Live individual and group lessons for children, teenagers and adults — with speaking practice,
        games and real-life communication at the heart of every class.
      </p>
      <div class="actions">
        <a class="primary" href="https://online.honey.school/">Open the learning platform</a>
        <a href="https://key.honey.school/">Open the keyboard trainer</a>
      </div>
      <footer>Honey School · Learning through communication</footer>
    </main>
  </body>
</html>
