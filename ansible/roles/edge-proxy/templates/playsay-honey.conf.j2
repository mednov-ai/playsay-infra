map $http_upgrade $playsay_connection_upgrade {
    default upgrade;
    '' close;
}

# Geographic entry is a browser-navigation decision at the outer AX41 edge.
# The MMDB updater owns only $honey_school_geo_country_code. All routing flags
# remain declarative, disabled by default and independent between environments.
map $host $honey_school_geo_redirect_flag {
    default 0;
    honey.school {{ 1 if honey_school_geoip_redirect_prod_enabled | bool else 0 }};
    online.honey.school {{ 1 if honey_school_geoip_redirect_prod_enabled | bool else 0 }};
    key.honey.school {{ 1 if honey_school_geoip_redirect_prod_enabled | bool else 0 }};
    dev.online.honey.school {{ 1 if honey_school_geoip_redirect_dev_enabled | bool else 0 }};
    dev.key.honey.school {{ 1 if honey_school_geoip_redirect_dev_enabled | bool else 0 }};
}

map $host $honey_school_geo_redirect_host {
    default "";
    honey.school honeyschool.ru;
    online.honey.school online.honeyschool.ru;
    key.honey.school key.honeyschool.ru;
    dev.online.honey.school dev.online.honeyschool.ru;
    dev.key.honey.school dev.key.honeyschool.ru;
}

map $remote_addr $honey_school_geo_direct_peer {
    default 1;
{% for trusted_address in honey_school_geoip_trusted_rf_proxy_addresses %}
    {{ trusted_address }} 0;
{% endfor %}
}

map "$request_method:$http_sec_fetch_mode:$http_accept" $honey_school_geo_browser_navigation {
    default 0;
    ~^(GET|HEAD):navigate: 1;
    ~^(GET|HEAD)::.*text/html 1;
}

map $request_uri $honey_school_geo_excluded_path {
    default 0;
    ~^/\.well-known/acme-challenge/ 1;
    ~^/(api|auth|keycloak|livekit|collab|ws)(/|\?|$) 1;
}

map $http_upgrade $honey_school_geo_no_upgrade {
    default 0;
    "" 1;
}

map "$honey_school_geo_country_code:$honey_school_geo_redirect_flag:$honey_school_geo_direct_peer:$honey_school_geo_browser_navigation:$honey_school_geo_excluded_path:$honey_school_geo_no_upgrade" $honey_school_geo_redirect_decision {
    default 0;
    "RU:1:1:1:0:1" 1;
}

limit_req_zone $binary_remote_addr zone=playsay_hooks:10m rate=5r/s;

{% set root_certificate = edge_root_certificate_after | default(edge_root_certificate) %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ edge_root_site.hostname }};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/playsay-acme;
        default_type text/plain;
    }

{% if root_certificate.stat.exists %}
    location / {
        return 301 https://{{ edge_root_site.hostname }}$request_uri;
    }
{% else %}
    root {{ edge_root_site.document_root }};
    index index.html;

    location / {
        include /etc/nginx/snippets/honey-school-browser-entry.conf;
        try_files $uri $uri/ /index.html;
    }
{% endif %}
}

{% if root_certificate.stat.exists %}
server {
    listen 443 ssl{% if edge_http2_enabled | default(false) %} http2{% endif %};
    listen [::]:443 ssl{% if edge_http2_enabled | default(false) %} http2{% endif %};
    server_name {{ edge_root_site.hostname }};

    ssl_certificate /etc/letsencrypt/live/{{ edge_root_site.certificate_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ edge_root_site.certificate_name }}/privkey.pem;
    ssl_protocols {{ edge_tls_protocols }};
    ssl_session_cache shared:PlaySayTLS:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; font-src 'self'; img-src 'self' data:; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;

    root {{ edge_root_site.document_root }};
    index index.html;

    location / {
        include /etc/nginx/snippets/honey-school-browser-entry.conf;
        try_files $uri $uri/ /index.html;
    }
}
{% endif %}

{% for route in edge_routes %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ route.hostname }};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/playsay-acme;
        default_type text/plain;
    }

{% if edge_certificate.stat.exists %}
    location / {
        return 301 https://$host$request_uri;
    }
{% elif route.kind in ['online', 'keyboard'] %}
    location / {
        include /etc/nginx/snippets/honey-school-browser-entry.conf;
        proxy_pass http://{{ route.upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
{% else %}
    location / {
        return 503;
    }
{% endif %}
}

{% if edge_certificate.stat.exists %}
server {
    listen 443 ssl{% if edge_http2_enabled | default(false) %} http2{% endif %};
    listen [::]:443 ssl{% if edge_http2_enabled | default(false) %} http2{% endif %};
    server_name {{ route.hostname }};

    ssl_certificate /etc/letsencrypt/live/{{ edge_certificate_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ edge_certificate_name }}/privkey.pem;
    ssl_protocols {{ edge_tls_protocols }};
    ssl_session_cache shared:PlaySayTLS:10m;
    ssl_session_timeout 1d;

{% if route.kind == 'online' %}
{% if route.livekit_upstream is defined %}
    location = /livekit {
        include /etc/nginx/snippets/playsay-livekit-signaling.conf;
        return 301 /livekit/;
    }

    location /livekit/ {
        include /etc/nginx/snippets/playsay-livekit-signaling.conf;
        proxy_pass http://{{ route.livekit_upstream }}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $playsay_connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
{% endif %}

{% if route.collaboration_upstream is defined %}
    location = /collab/ws {
        access_log off;
        proxy_pass http://{{ route.collaboration_upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $playsay_connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
{% endif %}

    location / {
        include /etc/nginx/snippets/honey-school-browser-entry.conf;
        proxy_pass http://{{ route.upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $playsay_connection_upgrade;
        proxy_read_timeout 660s;
        proxy_send_timeout 660s;
        proxy_buffering off;
    }
{% elif route.kind == 'keyboard' %}
{% if route.legacy_keycloak_upstream is defined %}
    # Temporary compatibility path for frontend images built before the
    # Keycloak issuer moved to ops.*. Remove after the new release is accepted.
    location = /keycloak {
        return 301 /keycloak/;
    }

    location /keycloak/ {
        proxy_pass http://{{ route.legacy_keycloak_upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $playsay_connection_upgrade;
        proxy_read_timeout 660s;
        proxy_send_timeout 660s;
        proxy_buffering off;
    }
{% endif %}

    location / {
        include /etc/nginx/snippets/honey-school-browser-entry.conf;
        proxy_pass http://{{ route.upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $playsay_connection_upgrade;
        proxy_read_timeout 660s;
        proxy_send_timeout 660s;
        proxy_buffering off;
    }
{% elif route.kind == 'ops' %}
    location = /keycloak {
        return 301 /keycloak/;
    }

    location /keycloak/ {
        proxy_pass http://{{ route.keycloak_upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $playsay_connection_upgrade;
        proxy_read_timeout 660s;
        proxy_send_timeout 660s;
        proxy_buffering off;
    }

    location /argocd/ {
        allow {{ edge_vpn_subnet }};
        deny all;
        proxy_pass http://{{ route.argocd_upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $playsay_connection_upgrade;
    }

    location /headlamp/ {
        allow {{ edge_vpn_subnet }};
        deny all;
        proxy_pass http://{{ route.headlamp_upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $playsay_connection_upgrade;
    }

    location /victoria-metrics/ {
        allow {{ edge_vpn_subnet }};
        deny all;
        proxy_pass http://{{ route.victoria_metrics_upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

{% if route.victoria_logs_enabled | default(false) | bool %}
    # BEGIN DEV LOG INGRESS
{% include 'dev-log-ingress.conf.j2' %}
    # END DEV LOG INGRESS
{% endif %}

    location / {
        return 404;
    }
{% elif route.kind == 'jenkins' %}
    location / {
        allow {{ edge_vpn_subnet }};
        deny all;
        proxy_pass http://{{ route.upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $playsay_connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
{% elif route.kind == 'hooks' %}
    location = /generic-webhook-trigger/invoke {
        limit_except POST { deny all; }
        limit_req zone=playsay_hooks burst=20 nodelay;
        client_max_body_size 2m;
        proxy_pass http://{{ route.jenkins_upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }

    location = /argocd/api/webhook {
        limit_except POST { deny all; }
        limit_req zone=playsay_hooks burst=20 nodelay;
        client_max_body_size 2m;
        proxy_pass http://{{ route.argocd_upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }

    location / {
        return 404;
    }
{% endif %}
}
{% endif %}
{% endfor %}
