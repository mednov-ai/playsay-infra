map $http_upgrade $playsay_connection_upgrade {
    default upgrade;
    '' close;
}

{% for route in edge_routes %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ route.hostname }};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/playsay-acme;
        default_type text/plain;
    }

{% if edge_certificate.stat.exists %}
    location / {
        return 301 https://$host$request_uri;
    }
{% else %}
    location / {
        proxy_pass http://{{ route.upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $playsay_connection_upgrade;
        proxy_read_timeout 660s;
        proxy_send_timeout 660s;
    }
{% endif %}
}

{% if edge_certificate.stat.exists %}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ route.hostname }};

    ssl_certificate /etc/letsencrypt/live/{{ edge_certificate_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ edge_certificate_name }}/privkey.pem;
    ssl_protocols TLSv1.2;
    ssl_session_cache shared:PlaySayTLS:10m;
    ssl_session_timeout 1d;

{% if route.livekit_upstream is defined %}
    location = /livekit {
        return 301 /livekit/;
    }

    location /livekit/ {
        proxy_pass http://{{ route.livekit_upstream }}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $playsay_connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
{% endif %}

{% if route.collaboration_upstream is defined %}
    location = /collab/ws {
        proxy_pass http://{{ route.collaboration_upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $playsay_connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
{% endif %}

    location / {
        proxy_pass http://{{ route.upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $playsay_connection_upgrade;
        proxy_read_timeout 660s;
        proxy_send_timeout 660s;
        proxy_buffering off;
    }
}
{% endif %}
{% endfor %}
