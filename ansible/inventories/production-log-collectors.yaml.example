all:
  children:
    production_log_collectors:
      vars:
        production_logs_enabled: false
        ansible_ssh_private_key_file: /absolute/path/to/play_and_say_vps_ed25519
      hosts:
        playsay-rf-edge:
          ansible_host: 94.102.89.213
          ansible_user: root
          production_logs_profile: rf
        playsay-ax41:
          ansible_host: 65.109.55.110
          ansible_user: root
          production_logs_profile: ax41
        playsay-prod:
          ansible_host: 10.60.0.20
          ansible_user: playsay
          ansible_ssh_common_args: '-o ProxyJump=root@65.109.55.110'
          production_logs_profile: prod
