\o '__OUTPUT_DIR__/object-keys.tsv'
COPY (
  SELECT encode(convert_to(storage_key, 'UTF8'), 'hex'), 'MATERIAL_ASSET'
  FROM material_asset
  WHERE material_id IN (SELECT id FROM sync_materials) AND storage_key IS NOT NULL AND storage_key <> ''
  UNION ALL
  SELECT encode(convert_to(snapshot_storage_key, 'UTF8'), 'hex'), 'COLLABORATION_SNAPSHOT'
  FROM collaboration_document
  WHERE lesson_id IN (SELECT id FROM sync_lessons)
    AND snapshot_storage_key IS NOT NULL AND snapshot_storage_key <> ''
  UNION ALL
  SELECT encode(convert_to(storage_key, 'UTF8'), 'hex'), 'YOUTUBE_CACHE'
  FROM youtube_video_cache
  WHERE id IN (SELECT id FROM sync_caches) AND storage_key IS NOT NULL AND storage_key <> ''
  ORDER BY 1, 2
) TO STDOUT WITH (FORMAT csv, DELIMITER E'\t');
\o

\o '__OUTPUT_DIR__/database-schema.tsv'
COPY (
  SELECT table_name, ordinal_position, column_name, data_type, udt_name, is_nullable, coalesce(column_default, '')
  FROM information_schema.columns
  WHERE table_schema = 'public'
    AND table_name IN (
      'app_user','student_profile','teacher_profile','course','curriculum_topic','lesson_material',
      'material_asset','material_html_game_enrichment','material_game_adaptation','youtube_video_cache',
      'youtube_video_cache_reference','lesson_template','lesson_template_card','lesson','lesson_participant',
      'lesson_email_reminder','assignment','assignment_recipient','submission','lesson_material_annotation',
      'collaboration_document','vocabulary_entries','vocabulary_occurrences','vocabulary_skill_states',
      'vocabulary_practice_plans','vocabulary_practices','vocabulary_practice_sessions',
      'vocabulary_practice_items','vocabulary_practice_attempts'
    )
  ORDER BY table_name, ordinal_position
) TO STDOUT WITH (FORMAT csv, DELIMITER E'\t');
\o

\o '__OUTPUT_DIR__/source-counts.tsv'
SELECT 'users' || E'\t' || count(*) FROM sync_user_ids;
SELECT 'lessons' || E'\t' || count(*) FROM sync_lessons;
SELECT 'materials' || E'\t' || count(*) FROM sync_materials;
SELECT 'assignments' || E'\t' || count(*) FROM sync_assignments;
SELECT 'vocabularyEntries' || E'\t' || count(*) FROM sync_entries;
SELECT 'vocabularyPractices' || E'\t' || count(*) FROM sync_practices;
\o

COMMIT;
