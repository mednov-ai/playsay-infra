\copy stg_lesson_participant FROM '__DATA_DIR__/tables/lesson_participant.csv' CSV HEADER
\copy stg_lesson_email_reminder FROM '__DATA_DIR__/tables/lesson_email_reminder.csv' CSV HEADER
