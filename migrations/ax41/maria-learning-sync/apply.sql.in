SELECT setval(
  pg_get_serial_sequence('vocabulary_occurrences', 'id'),
  greatest(coalesce((SELECT max(id) FROM vocabulary_occurrences), 1), 1),
  EXISTS (SELECT 1 FROM vocabulary_occurrences)
);

COMMIT;
