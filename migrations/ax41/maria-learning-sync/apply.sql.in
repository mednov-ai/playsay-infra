\set ON_ERROR_STOP on
\set QUIET 1
\set maria_subject `tr -d '\r\n' < '__MARIA_SUBJECT_FILE__'`
\set cutoff_at `tr -d '\r\n' < '__CUTOFF_FILE__'`

BEGIN TRANSACTION ISOLATION LEVEL SERIALIZABLE;
SET LOCAL lock_timeout = '15s';
SET LOCAL statement_timeout = '20min';
CREATE TEMP TABLE input_maria_subject(subject text PRIMARY KEY);
INSERT INTO input_maria_subject VALUES (:'maria_subject');

CREATE TEMP TABLE stg_app_user (LIKE app_user INCLUDING DEFAULTS);
