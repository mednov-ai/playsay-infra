{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honey.school/schemas/ax41-migration-manifest-v1.json",
  "title": "Play&Say AX41 migration bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleId",
    "createdAt",
    "sourceHost",
    "targetEnvironment",
    "platformCommit",
    "infraCommit",
    "components"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "bundleId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "sourceHost": { "type": "string", "minLength": 1 },
    "targetEnvironment": { "enum": ["dev", "prod"] },
    "platformCommit": { "type": "string", "minLength": 1 },
    "infraCommit": { "type": "string", "minLength": 1 },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicationPostgreSQL",
        "keyboardPostgreSQL",
        "keycloakPostgreSQL",
        "minio",
        "sealedSecretsKeys"
      ],
      "properties": {
        "applicationPostgreSQL": { "type": "string", "minLength": 1 },
        "keyboardPostgreSQL": { "type": "string", "minLength": 1 },
        "keycloakPostgreSQL": { "type": "string", "minLength": 1 },
        "minio": { "type": "string", "minLength": 1 },
        "sealedSecretsKeys": { "type": "boolean" }
      }
    }
  }
}
